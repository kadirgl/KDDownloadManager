{
  "manifest_version": 3,
  "name": "KD Download Manager",
  "version": "1.8.1",
  "description": "İndirmeleri, magnet linklerini ve videoları KD Download Manager'a gönderir.",
  "key": "",
  "permissions": ["downloads", "contextMenus", "storage", "cookies", "activeTab", "alarms", "webRequest"],
  "host_permissions": ["http://127.0.0.1:47615/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["menu.js", "youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["menu.js", "videos.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "KD Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
